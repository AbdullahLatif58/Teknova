<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; }
    .container { max-width: 600px; margin: 0 auto; padding: 20px; border: 1px solid #eee; border-radius: 10px; }
    .header { text-align: center; padding-bottom: 20px; border-bottom: 2px solid #0070f3; }
    .header h2 { color: #0070f3; margin: 0; }
    .order-info { margin: 20px 0; padding: 15px; background-color: #f9f9f9; border-radius: 8px; }
    .item-list { width: 100%; border-collapse: collapse; margin: 20px 0; }
    .item-list th { text-align: left; padding: 10px; border-bottom: 1px solid #ddd; }
    .item-list td { padding: 10px; border-bottom: 1px solid #eee; vertical-align: middle; }
    .item-img { width: 50px; height: 50px; object-fit: cover; border-radius: 5px; margin-right: 10px; }
    .total-section { text-align: right; font-size: 1.2em; font-weight: bold; margin-top: 20px; }
    .footer { text-align: center; font-size: 0.8em; color: #777; margin-top: 30px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h2>Order Confirmation</h2>
    </div>
    <div class="content">
      <p>Hi <strong>{{name}}</strong>,</p>
      <p>Thank you for shopping with Teknova! Your order has been placed successfully and is now being processed.</p>
      
      <div class="order-info">
        <strong>Order ID:</strong> #{{orderId}}<br>
        <strong>Status:</strong> Pending<br>
        <strong>Date:</strong> {{date}}
      </div>

      <h3>Order Summary</h3>
      <table class="item-list">
        <thead>
          <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Price</th>
          </tr>
        </thead>
        <tbody>
          {{#each items}}
          <tr>
            <td>
              <div style="display: flex; align-items: center;">
                <img src="{{image}}" alt="{{name}}" class="item-img" />
                <span>{{name}}</span>
              </div>
            </td>
            <td>{{quantity}}</td>
            <td>${{price}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>

      <div class="total-section">
        Total Amount: ${{total}}
      </div>

      <p>We'll send you another email when your order ships.</p>
    </div>
    <div class="footer">
      &copy; 2026 Teknova E-Commerce. All rights reserved.
    </div>
  </div>
</body>
</html>