<!DOCTYPE html>
<html>
<head>
  <style>
    body { font-family: Arial, sans-serif; }
    .container { padding: 20px; background: #f4f4f4; }
    .content { background: #fff; padding: 20px; border-radius: 5px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="content">
      <h2>Order Confirmation</h2>
      <p>Hi {{name}},</p>
      <p>Thank you for your order #{{orderId}}. We are processing it now.</p>
      <p>Total: ${{total}}</p>
    </div>
  </div>
</body>
</html>